{
  "name": "@nahook/management",
  "version": "0.1.0",
  "description": "Nahook management SDK — programmatic webhook, event type, and application management",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@nahook/core": "*"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["nahook", "webhooks", "management", "api"],
  "license": "MIT"
}
