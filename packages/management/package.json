  "author": {
    "name": "Nahook",
    "email": "support@nahook.com",
    "url": "https://nahook.com"
  },
  "homepage": "https://github.com/getnahook/nahook-node#readme",
  "bugs": "https://github.com/getnahook/nahook-node/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getnahook/nahook-node.git",
    "directory": "packages/management"
  }
}
